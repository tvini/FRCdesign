</style>

<script>
  import { USERS, TOTAL_COURSE_LESSONS, calculateLevel, INITIAL_STUDENT_PROGRESS } from '../../data/users';

  // Storage Keys
  const STORAGE_SESSION_KEY = 'frcdesign_auth_session';
  const STORAGE_PROGRESS_KEY = 'frcdesign_student_progress_db';

  // Initialize DB in localStorage if not exists
  function getProgressDB(): Record<string, any> {
    try {
      const stored = localStorage.getItem(STORAGE_PROGRESS_KEY);
      if (stored) {
        return JSON.parse(stored);
      }
    } catch (e) {
      console.error('Error reading progress DB', e);
    }
    // Set default initial data
    localStorage.setItem(STORAGE_PROGRESS_KEY, JSON.stringify(INITIAL_STUDENT_PROGRESS));
    return { ...INITIAL_STUDENT_PROGRESS };
  }

  function saveProgressDB(db: Record<string, any>) {
    localStorage.setItem(STORAGE_PROGRESS_KEY, JSON.stringify(db));
    // Trigger custom event so any component/tab updates
    window.dispatchEvent(new CustomEvent('frcdesign_progress_updated'));
  }

  function getActiveUser(): any | null {
    try {
      const session = localStorage.getItem(STORAGE_SESSION_KEY);
      if (session) {
        const parsed = JSON.parse(session);
        return USERS[parsed.userId] || null;
      }
    } catch (e) {
      console.error('Error reading session', e);
    }
    return null;
  }

  function setActiveUser(userId: string) {
    localStorage.setItem(STORAGE_SESSION_KEY, JSON.stringify({ userId, loginTime: new Date().toISOString() }));
  }

  function clearActiveUser() {
    localStorage.removeItem(STORAGE_SESSION_KEY);
  }

  // Confetti Particle Generator
  function fireConfetti() {
    const container = document.getElementById('celebration-confetti');
    if (!container) return;
    container.innerHTML = '';
    container.classList.remove('hidden');

    const colors = ['#43a047', '#81c784', '#ffeb3b', '#2196f3', '#e91e63', '#9c27b0', '#ff9800'];
    const count = 50;

    for (let i = 0; i < count; i++) {
      const piece = document.createElement('div');
      piece.className = 'confetti-piece';
      piece.style.left = Math.random() * 100 + 'vw';
      piece.style.top = -20 + 'px';
      piece.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
      piece.style.transform = `rotate(${Math.random() * 360}deg)`;
      piece.style.animationDelay = Math.random() * 0.8 + 's';
      piece.style.animationDuration = 2 + Math.random() * 1.5 + 's';
      container.appendChild(piece);
    }

    setTimeout(() => {
      container.classList.add('hidden');
      container.innerHTML = '';
    }, 3500);
  }

  // Update UI based on active user
  function updateAuthUI() {
    const user = getActiveUser();
    const loginWall = document.getElementById('login-wall-overlay');
    const headerWidget = document.getElementById('user-header-widget');
    const studentTracker = document.getElementById('student-course-tracker');
    const mentorBtn = document.getElementById('open-mentor-panel-btn');

    // 1. Check Login Wall
    if (!user) {
      loginWall?.classList.remove('hidden');
      headerWidget?.classList.add('hidden');
      studentTracker?.classList.add('hidden');
      document.body.style.overflow = 'hidden';
      return;
    }

    // User is logged in
    loginWall?.classList.add('hidden');
    headerWidget?.classList.remove('hidden');
    document.body.style.overflow = '';

    // Update Header Pill
    const avatarEl = document.getElementById('user-avatar');
    const nameEl = document.getElementById('user-display-name');
    const roleEl = document.getElementById('user-role-badge');
    const statsRow = document.getElementById('user-stats-row');
    const xpEl = document.getElementById('user-xp-display');
    const levelEl = document.getElementById('user-level-display');

    if (avatarEl) avatarEl.textContent = user.avatar;
    if (nameEl) nameEl.textContent = user.name;
    if (roleEl) {
      roleEl.textContent = user.title;
      roleEl.className = `role-badge ${user.role}`;
    }

    const db = getProgressDB();

    if (user.role === 'student') {
      mentorBtn?.classList.add('hidden');
      statsRow?.classList.remove('hidden');

      const studentData = db[user.id] || { completedLessons: [], xp: 0 };
      const levelObj = calculateLevel(studentData.xp || 0);

      if (xpEl) xpEl.textContent = `${studentData.xp || 0} XP`;
      if (levelEl) levelEl.textContent = `Nível ${levelObj.level}`;

      // Update current location in course
      const currentPath = window.location.pathname;
      if (currentPath.includes('/learning-course/')) {
        const pageTitle = document.querySelector('h1')?.textContent?.trim() || document.title;
        studentData.lastPage = currentPath;
        studentData.lastPageTitle = pageTitle;
        studentData.lastActive = 'Agora mesmo';
        db[user.id] = studentData;
        saveProgressDB(db);

        // Show course gamification floating tracker
        updateStudentCourseTracker(user.id);
      } else {
        studentTracker?.classList.add('hidden');
      }

      // Mark sidebar links with checkmarks
      decorateSidebarWithCheckmarks(studentData.completedLessons || []);
    } else {
      // Mentor logged in
      mentorBtn?.classList.remove('hidden');
      statsRow?.classList.add('hidden');
      studentTracker?.classList.add('hidden');
    }
  }

  // Update floating course tracker for student
  function updateStudentCourseTracker(studentId: string) {
    const studentTracker = document.getElementById('student-course-tracker');
    if (!studentTracker) return;

    studentTracker.classList.remove('hidden');

    const db = getProgressDB();
    const student = db[studentId] || { completedLessons: [], xp: 0 };
    const completedCount = (student.completedLessons || []).length;
    const percent = Math.min(100, Math.round((completedCount / TOTAL_COURSE_LESSONS) * 100));
    const levelObj = calculateLevel(student.xp || 0);

    const levelNameEl = document.getElementById('tracker-level-name');
    const xpValEl = document.getElementById('tracker-xp-val');
    const percentText = document.getElementById('tracker-percent-text');
    const progressFill = document.getElementById('tracker-progress-fill');
    const countEl = document.getElementById('tracker-completed-count');
    const markBtn = document.getElementById('mark-lesson-complete-btn');
    const markBtnText = document.getElementById('mark-btn-text');
    const markBtnIcon = document.getElementById('mark-btn-icon');

    if (levelNameEl) levelNameEl.textContent = `${levelObj.icon} ${levelObj.name}`;
    if (xpValEl) xpValEl.textContent = `${student.xp || 0} XP`;
    if (percentText) percentText.textContent = `${percent}%`;
    if (progressFill) progressFill.style.width = `${percent}%`;
    if (countEl) countEl.textContent = String(completedCount);

    // Check if current page is marked completed
    const currentPath = window.location.pathname;
    const isCompleted = (student.completedLessons || []).includes(currentPath);

    if (markBtn && markBtnText && markBtnIcon) {
      if (isCompleted) {
        markBtn.classList.add('completed');
        markBtnIcon.textContent = '✓';
        markBtnText.textContent = 'Lição Concluída (+50 XP obtidos)';
      } else {
        markBtn.classList.remove('completed');
        markBtnIcon.textContent = '✓';
        markBtnText.textContent = 'Concluir esta Lição (+50 XP)';
      }
    }
  }

  // Decorate Starlight sidebar links with green checkmarks
  function decorateSidebarWithCheckmarks(completedLessons: string[]) {
    const sidebarLinks = document.querySelectorAll('#starlight__sidebar a[href], .sidebar-content a[href]');
    sidebarLinks.forEach((link) => {
      const href = link.getAttribute('href');
      if (!href) return;

      const normalizedHref = href.endsWith('/') ? href : href + '/';
      const isDone = completedLessons.some((c) => c === href || c === normalizedHref);

      const existingBadge = link.querySelector('.lesson-check-badge');
      if (isDone) {
        if (!existingBadge) {
          const badge = document.createElement('span');
          badge.className = 'lesson-check-badge';
          badge.textContent = ' ✓';
          badge.style.color = '#81c784';
          badge.style.fontWeight = 'bold';
          badge.style.fontSize = '0.9em';
          badge.style.marginLeft = '4px';
          link.appendChild(badge);
        }
      } else if (existingBadge) {
        existingBadge.remove();
      }
    });
  }

  // Render Mentor Dashboard
  function renderMentorDashboard() {
    const container = document.getElementById('mentor-students-container');
    if (!container) return;

    const db = getProgressDB();
    const students = [USERS.isa, USERS.ana, USERS.lucas];

    let totalLessonsDone = 0;
    let highestLessons = -1;
    let mvpName = 'Ana';

    container.innerHTML = '';

    students.forEach((studentUser) => {
      const data = db[studentUser.id] || { completedLessons: [], xp: 0, lastPage: '', lastPageTitle: '', lastActive: '' };
      const completedCount = (data.completedLessons || []).length;
      totalLessonsDone += completedCount;

      if (completedCount > highestLessons) {
        highestLessons = completedCount;
        mvpName = studentUser.name;
      }

      const percent = Math.min(100, Math.round((completedCount / TOTAL_COURSE_LESSONS) * 100));
      const levelObj = calculateLevel(data.xp || 0);

      const card = document.createElement('div');
      card.className = 'student-mentor-card';
      card.innerHTML = `
        <div class="student-top-info">
          <div class="student-avatar-block">
            <div class="student-big-avatar">${studentUser.avatar}</div>
            <div class="student-names">
              <h4>${studentUser.name}</h4>
              <span class="student-sub-level">${levelObj.icon} ${levelObj.name} • <strong>${data.xp || 0} XP</strong></span>
            </div>
          </div>
          <div class="student-progress-badge">
            <span class="student-percent-big">${percent}%</span>
            <div class="student-lesson-count">${completedCount} de ${TOTAL_COURSE_LESSONS} lições</div>
          </div>
        </div>

        <div class="student-bar-wrapper">
          <div class="student-bar-fill" style="width: ${percent}%"></div>
        </div>

        <div class="student-location-box">
          <div class="location-text">
            <span>📍 <strong>Onde está agora:</strong></span>
            ${data.lastPage ? `<a href="${data.lastPage}" class="location-link">${data.lastPageTitle || data.lastPage}</a>` : '<span style="color:#9e9e9e">Ainda não iniciou</span>'}
          </div>
          <span class="last-active-time">${data.lastActive || 'Recente'}</span>
        </div>
      `;
      container.appendChild(card);
    });

    // Update Team Metrics Summary
    const avgProgress = Math.round((totalLessonsDone / (students.length * TOTAL_COURSE_LESSONS)) * 100);
    const avgProgressEl = document.getElementById('team-avg-progress');
    const totalLessonsEl = document.getElementById('team-total-lessons');
    const mvpEl = document.getElementById('team-mvp-student');

    if (avgProgressEl) avgProgressEl.textContent = `${avgProgress}%`;
    if (totalLessonsEl) totalLessonsEl.textContent = String(totalLessonsDone);
    if (mvpEl) mvpEl.textContent = mvpName;
  }

  // Event Listeners Initialization
  function initAuthEvents() {
    // 1. Profile chip click in login wall
    const chips = document.querySelectorAll('.profile-chip');
    const usernameInput = document.getElementById('login-username') as HTMLInputElement;
    const passwordInput = document.getElementById('login-password') as HTMLInputElement;
    const errorMsg = document.getElementById('login-error-msg');

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.classList.remove('selected'));
        chip.classList.add('selected');

        const userId = chip.getAttribute('data-user-id') || '';
        if (usernameInput) usernameInput.value = userId;

        // Auto-fill password for convenience
        const userObj = USERS[userId];
        if (userObj && passwordInput) {
          passwordInput.value = userObj.password;
        }
        errorMsg?.classList.add('hidden');
      });
    });

    // 2. Toggle password visibility
    const togglePassBtn = document.getElementById('toggle-password-btn');
    if (togglePassBtn && passwordInput) {
      togglePassBtn.addEventListener('click', () => {
        const isPass = passwordInput.type === 'password';
        passwordInput.type = isPass ? 'text' : 'password';
      });
    }

    // 3. Login form submit
    const loginForm = document.getElementById('login-form');
    if (loginForm) {
      loginForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const username = usernameInput.value.trim().toLowerCase();
        const password = passwordInput.value.trim();

        const user = USERS[username];
        if (user && user.password === password) {
          errorMsg?.classList.add('hidden');
          setActiveUser(username);
          updateAuthUI();
        } else {
          errorMsg?.classList.remove('hidden');
        }
      });
    }

    // 4. Logout button
    const logoutBtn = document.getElementById('logout-btn');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', () => {
        if (confirm('Deseja realmente sair da sua conta?')) {
          clearActiveUser();
          updateAuthUI();
        }
      });
    }

    // 5. Mentor modal open/close
    const openMentorBtn = document.getElementById('open-mentor-panel-btn');
    const closeMentorBtn = document.getElementById('close-mentor-modal-btn');
    const mentorModal = document.getElementById('mentor-modal-overlay');

    if (openMentorBtn && mentorModal) {
      openMentorBtn.addEventListener('click', () => {
        renderMentorDashboard();
        mentorModal.classList.remove('hidden');
      });
    }

    if (closeMentorBtn && mentorModal) {
      closeMentorBtn.addEventListener('click', () => {
        mentorModal.classList.add('hidden');
      });
    }

    if (mentorModal) {
      mentorModal.addEventListener('click', (e) => {
        if (e.target === mentorModal) {
          mentorModal.classList.add('hidden');
        }
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mentorModal && !mentorModal.classList.contains('hidden')) {
        mentorModal.classList.add('hidden');
      }
    });

    // 6. Mentor export report button
    const exportBtn = document.getElementById('btn-export-report');
    if (exportBtn) {
      exportBtn.addEventListener('click', () => {
        const db = getProgressDB();
        const students = [USERS.isa, USERS.ana, USERS.lucas];
        let report = `📊 RELATÓRIO DE PROGRESSO FRCDesign.org (${new Date().toLocaleDateString('pt-BR')})\n\n`;

        students.forEach((s) => {
          const data = db[s.id] || { completedLessons: [], xp: 0, lastPageTitle: '' };
          const percent = Math.round(((data.completedLessons || []).length / TOTAL_COURSE_LESSONS) * 100);
          report += `👤 ${s.name} (${s.title}):\n`;
          report += `   - Progresso: ${percent}% (${(data.completedLessons || []).length}/${TOTAL_COURSE_LESSONS} lições)\n`;
          report += `   - XP Acumulado: ${data.xp || 0} XP\n`;
          report += `   - Localização atual: ${data.lastPageTitle || 'Início'}\n\n`;
        });

        navigator.clipboard.writeText(report).then(() => {
          alert('✅ Relatório copiado para a área de transferência!');
        });
      });
    }

    // 7. Mentor reset demo data button
    const resetBtn = document.getElementById('btn-reset-demo');
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (confirm('Deseja recarregar os dados iniciais de demonstração dos alunos?')) {
          localStorage.setItem(STORAGE_PROGRESS_KEY, JSON.stringify(INITIAL_STUDENT_PROGRESS));
          renderMentorDashboard();
          updateAuthUI();
          alert('🔄 Dados iniciais recarregados com sucesso!');
        }
      });
    }

    // 8. Mark lesson complete button for students
    const markLessonBtn = document.getElementById('mark-lesson-complete-btn');
    if (markLessonBtn) {
      markLessonBtn.addEventListener('click', () => {
        const user = getActiveUser();
        if (!user || user.role !== 'student') return;

        const currentPath = window.location.pathname;
        const db = getProgressDB();
        const student = db[user.id] || { completedLessons: [], xp: 0 };
        student.completedLessons = student.completedLessons || [];

        const index = student.completedLessons.indexOf(currentPath);
        if (index === -1) {
          // Add completion
          student.completedLessons.push(currentPath);
          student.xp = (student.xp || 0) + 50;

          // Celebration!
          fireConfetti();

          // Level up check
          const oldLevel = calculateLevel(student.xp - 50).level;
          const newLevel = calculateLevel(student.xp).level;
          if (newLevel > oldLevel) {
            setTimeout(() => {
              alert(`🎉 PARABÉNS, ${user.name}! Você subiu para o Nível ${newLevel}: ${calculateLevel(student.xp).name}! 🏆`);
            }, 600);
          }
        } else {
          // Toggle off if clicked again
          student.completedLessons.splice(index, 1);
          student.xp = Math.max(0, (student.xp || 0) - 50);
        }

        db[user.id] = student;
        saveProgressDB(db);
        updateAuthUI();
      });
    }

    // 9. Minimize tracker button
    const toggleMinBtn = document.getElementById('toggle-tracker-min-btn');
    const trackerBody = document.getElementById('tracker-body');
    if (toggleMinBtn && trackerBody) {
      toggleMinBtn.addEventListener('click', () => {
        const isHidden = trackerBody.classList.toggle('hidden');
        toggleMinBtn.textContent = isHidden ? '▴' : '▾';
      });
    }

    // Listen to custom updates across tabs/windows
    window.addEventListener('frcdesign_progress_updated', () => {
      updateAuthUI();
      if (mentorModal && !mentorModal.classList.contains('hidden')) {
        renderMentorDashboard();
      }
    });
  }

  function mountHeaderWidget() {
    const mount = document.getElementById('user-header-mount');
    const widget = document.getElementById('user-header-widget');
    if (mount && widget && widget.parentElement !== mount) {
      mount.appendChild(widget);
    }
  }

  // Run on initial load and Astro page transitions
  function init() {
    mountHeaderWidget();
    initAuthEvents();
    updateAuthUI();
  }

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    init();
  } else {
    document.addEventListener('DOMContentLoaded', init);
  }

  document.addEventListener('astro:page-load', init);
</script>
