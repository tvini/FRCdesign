---
/**
 * AuthAndProgress.astro
 * Sistema de Autenticação Obrigatória, Gamificação do Curso para Alunos e Painel de Mentoria.
 */
import { USERS, TOTAL_COURSE_LESSONS, LEVELS, INITIAL_STUDENT_PROGRESS } from '../../data/users';

const usersList = Object.values(USERS);
---

<div id="auth-system-root" data-total-lessons={TOTAL_COURSE_LESSONS}>
  <!-- 1. LOGIN WALL OVERLAY (Bloqueio Obrigatório) -->
  <div id="login-wall-overlay" class="login-overlay hidden">
    <div class="login-card">
      <div class="login-header">
        <div class="login-brand">
          <img src="/_astro/book.C-iZy4YT.svg" alt="FRCDesign Logo" width="48" height="48" class="login-logo" />
          <div>
            <span class="portal-badge">ÁREA RESTRITA DA EQUIPE</span>
            <h2 class="login-title">FRCDesign.org</h2>
          </div>
        </div>
        <p class="login-subtitle">Acesso restrito para alunos e mentores. Selecione seu perfil ou digite seus dados para entrar.</p>
      </div>

      <!-- Quick profile picker -->
      <div class="profile-picker-section">
        <span class="picker-label">Selecione seu perfil:</span>
        <div class="profile-chips">
          {usersList.map((user) => (
            <button
              type="button"
              class="profile-chip"
              data-user-id={user.id}
              data-user-role={user.role}
              data-user-name={user.name}
            >
              <span class="chip-avatar">{user.avatar}</span>
              <span class="chip-info">
                <strong class="chip-name">{user.name}</strong>
                <small class="chip-role">{user.title}</small>
              </span>
            </button>
          ))}
        </div>
      </div>

      <!-- Login Form -->
      <form id="login-form" class="login-form">
        <div class="form-group">
          <label for="login-username">Usuário</label>
          <input
            type="text"
            id="login-username"
            name="username"
            placeholder="Ex: isa, ana, lucas, liwia, vinicius"
            required
            autocomplete="username"
          />
        </div>

        <div class="form-group">
          <label for="login-password">Senha</label>
          <div class="password-wrapper">
            <input
              type="password"
              id="login-password"
              name="password"
              placeholder="Digite sua senha"
              required
              autocomplete="current-password"
            />
            <button type="button" id="toggle-password-btn" class="toggle-password-btn" aria-label="Mostrar/Ocultar senha">
              <svg id="eye-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
            </button>
          </div>
        </div>

        <div id="login-error-msg" class="login-error hidden">
          ⚠️ Senha incorreta ou usuário não encontrado.
        </div>

        <button type="submit" class="btn-primary-login">
          <span>Entrar no Portal</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </button>

        <div class="login-hint">
          <span>💡 <strong>Dica de acesso:</strong> a senha inicial de cada um é <code>nome123</code> (ex: <code>isa123</code>, <code>ana123</code>, <code>lucas123</code>, <code>liwia123</code>, <code>vinicius123</code>).</span>
        </div>
      </form>
    </div>
  </div>

  <!-- 2. TOP USER BAR (Injetado no topo ou Header) -->
  <div id="user-header-widget" class="user-header-widget hidden">
    <div class="user-info-pill">
      <span id="user-avatar" class="user-avatar">👤</span>
      <div class="user-meta">
        <div class="user-name-row">
          <strong id="user-display-name">Usuário</strong>
          <span id="user-role-badge" class="role-badge">Aluno</span>
        </div>
        <div id="user-stats-row" class="user-stats-row">
          <span id="user-xp-display" class="user-xp-display">0 XP</span>
          <span class="meta-separator">•</span>
          <span id="user-level-display" class="user-level-display">Nível 1</span>
        </div>
      </div>
    </div>

    <!-- Mentor Dashboard Trigger Button (Only for Mentors) -->
    <button type="button" id="open-mentor-panel-btn" class="btn-mentor-trigger hidden" title="Abrir painel de acompanhamento dos alunos">
      <span class="mentor-icon">📊</span>
      <span class="mentor-text">Painel dos Alunos</span>
      <span id="mentor-badge-count" class="mentor-badge-count">3</span>
    </button>

    <!-- Logout Button -->
    <button type="button" id="logout-btn" class="btn-logout" title="Sair da conta">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/>
      </svg>
      <span>Sair</span>
    </button>
  </div>

  <!-- 3. PAINEL DE MENTORIA SUSPENSO (MODAL FLOATING WINDOW) -->
  <div id="mentor-modal-overlay" class="mentor-modal-overlay hidden">
    <div class="mentor-modal-window">
      <div class="mentor-modal-header">
        <div class="mentor-title-group">
          <div class="mentor-header-icon">🎓</div>
          <div>
            <h3 class="mentor-modal-title">Painel de Acompanhamento da Mentoria</h3>
            <p class="mentor-modal-sub">Visão em tempo real do andamento e engajamento de cada aluno no Curso de Aprendizado.</p>
          </div>
        </div>
        <button type="button" id="close-mentor-modal-btn" class="close-modal-btn" aria-label="Fechar painel">✕</button>
      </div>

      <!-- Quick Metrics Summary -->
      <div class="mentor-metrics-row">
        <div class="metric-box">
          <span class="metric-value">3</span>
          <span class="metric-label">Alunos Ativos</span>
        </div>
        <div class="metric-box">
          <span id="team-avg-progress" class="metric-value">0%</span>
          <span class="metric-label">Média de Conclusão</span>
        </div>
        <div class="metric-box">
          <span id="team-total-lessons" class="metric-value">0</span>
          <span class="metric-label">Lições Concluídas</span>
        </div>
        <div class="metric-box highlight">
          <span id="team-mvp-student" class="metric-value">Ana</span>
          <span class="metric-label">Destaque Atual 🏆</span>
        </div>
      </div>

      <!-- Student Progress Cards List -->
      <div class="mentor-students-grid" id="mentor-students-container">
        <!-- Rendered dynamically via JS for Isa, Ana, Lucas -->
      </div>

      <!-- Mentor Actions Footer -->
      <div class="mentor-modal-footer">
        <div class="footer-note">
          <span>💡 <em>Dica:</em> O progresso é sincronizado e atualizado automaticamente sempre que um aluno conclui uma lição no Curso de Aprendizado.</span>
        </div>
        <div class="mentor-footer-btns">
          <button type="button" id="btn-export-report" class="btn-secondary-mentor">
            📋 Copiar Relatório
          </button>
          <button type="button" id="btn-reset-demo" class="btn-secondary-mentor" title="Recarregar dados iniciais de demonstração">
            🔄 Recarregar Dados Iniciais
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- 4. GAMIFIED FLOATING COURSE PROGRESS CARD (Para Alunos no Curso) -->
  <div id="student-course-tracker" class="student-course-tracker hidden">
    <div class="tracker-header">
      <div class="tracker-badge-row">
        <span class="tracker-game-icon">🎮</span>
        <span class="tracker-tag">CURSO DE APRENDIZADO</span>
      </div>
      <button type="button" id="toggle-tracker-min-btn" class="tracker-min-btn" title="Minimizar">▾</button>
    </div>

    <div class="tracker-body" id="tracker-body">
      <div class="tracker-level-info">
        <div>
          <span id="tracker-level-name" class="tracker-level-name">Aprendiz de CAD</span>
          <strong id="tracker-xp-val" class="tracker-xp-val">0 XP</strong>
        </div>
        <span id="tracker-percent-text" class="tracker-percent-text">0%</span>
      </div>

      <div class="progress-bar-track">
        <div id="tracker-progress-fill" class="progress-bar-fill" style="width: 0%"></div>
      </div>

      <div class="tracker-stats-text">
        <span id="tracker-completed-count">0</span> de <span id="tracker-total-count">{TOTAL_COURSE_LESSONS}</span> lições concluídas
      </div>

      <div class="tracker-actions">
        <button type="button" id="mark-lesson-complete-btn" class="btn-mark-lesson">
          <span id="mark-btn-icon" class="mark-btn-icon">✓</span>
          <span id="mark-btn-text">Concluir esta Lição (+50 XP)</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Confetti Celebration Container -->
  <div id="celebration-confetti" class="celebration-confetti hidden"></div>
</div>

<style>
  /* ==========================================================================
     Auth & Progress Root Styles
     ========================================================================== */
  .hidden {
    display: none !important;
  }

  /* 1. LOGIN WALL OVERLAY */
  .login-overlay {
    position: fixed;
    inset: 0;
    z-index: 999999;
    background: rgba(8, 12, 10, 0.88);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    overflow-y: auto;
  }

  .login-card {
    background: var(--sl-color-gray-6, #16181d);
    border: 1px solid rgba(67, 160, 71, 0.4);
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5), 0 0 30px rgba(67, 160, 71, 0.2);
    border-radius: 20px;
    width: 100%;
    max-width: 520px;
    padding: 2.25rem;
    color: var(--sl-color-white, #fff);
    animation: modalPop 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes modalPop {
    from {
      opacity: 0;
      transform: scale(0.94) translateY(12px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .login-header {
    margin-bottom: 1.5rem;
  }

  .login-brand {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .login-logo {
    filter: drop-shadow(0 4px 8px rgba(67, 160, 71, 0.4));
  }

  .portal-badge {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sl-color-text-accent, #43a047);
    background: rgba(67, 160, 71, 0.15);
    border: 1px solid rgba(67, 160, 71, 0.3);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    margin-bottom: 0.25rem;
  }

  .login-title {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .login-subtitle {
    margin: 0;
    font-size: 0.92rem;
    color: var(--sl-color-gray-2, #b5b8c2);
    line-height: 1.5;
  }

  /* Profile Picker Chips */
  .profile-picker-section {
    margin-bottom: 1.5rem;
  }

  .picker-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--sl-color-gray-3, #8b90a0);
    margin-bottom: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .profile-chips {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(90px, 1fr));
    gap: 0.5rem;
  }

  .profile-chip {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--sl-color-gray-5, #2e3340);
    border-radius: 12px;
    padding: 0.6rem 0.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: center;
  }

  .profile-chip:hover {
    background: rgba(67, 160, 71, 0.15);
    border-color: var(--sl-color-text-accent, #43a047);
    transform: translateY(-2px);
  }

  .profile-chip.selected {
    background: rgba(67, 160, 71, 0.22);
    border-color: var(--sl-color-text-accent, #43a047);
    box-shadow: 0 0 12px rgba(67, 160, 71, 0.3);
  }

  .chip-avatar {
    font-size: 1.4rem;
  }

  .chip-name {
    display: block;
    font-size: 0.82rem;
    color: #ffffff;
    line-height: 1.2;
  }

  .chip-role {
    display: block;
    font-size: 0.68rem;
    color: var(--sl-color-gray-3, #8b90a0);
  }

  /* Form */
  .login-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--sl-color-gray-2, #b5b8c2);
  }

  .form-group input {
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid var(--sl-color-gray-5, #2e3340);
    border-radius: 10px;
    padding: 0.75rem 1rem;
    font-size: 0.95rem;
    color: #ffffff;
    outline: none;
    transition: all 0.2s ease;
  }

  .form-group input:focus {
    border-color: var(--sl-color-text-accent, #43a047);
    box-shadow: 0 0 0 2px rgba(67, 160, 71, 0.3);
  }

  .password-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .password-wrapper input {
    width: 100%;
    padding-right: 2.75rem;
  }

  .toggle-password-btn {
    position: absolute;
    right: 0.75rem;
    background: none;
    border: none;
    color: var(--sl-color-gray-3, #8b90a0);
    cursor: pointer;
    padding: 0.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .toggle-password-btn:hover {
    color: #ffffff;
  }

  .login-error {
    background: rgba(244, 67, 54, 0.15);
    border: 1px solid rgba(244, 67, 54, 0.4);
    color: #ff8a80;
    padding: 0.7rem 0.9rem;
    border-radius: 8px;
    font-size: 0.85rem;
  }

  .btn-primary-login {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    background: var(--sl-color-text-accent, #43a047);
    color: #000000;
    font-size: 1rem;
    font-weight: 700;
    padding: 0.85rem 1.5rem;
    border-radius: 12px;
    border: none;
    cursor: pointer;
    transition: all 0.25s ease;
    margin-top: 0.5rem;
  }

  .btn-primary-login:hover {
    background: #4caf50;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(67, 160, 71, 0.4);
  }

  .login-hint {
    font-size: 0.8rem;
    color: var(--sl-color-gray-3, #8b90a0);
    background: rgba(255, 255, 255, 0.03);
    padding: 0.6rem 0.8rem;
    border-radius: 8px;
    border: 1px dashed rgba(255, 255, 255, 0.1);
  }

  .login-hint code {
    background: rgba(67, 160, 71, 0.2);
    color: #81c784;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    font-family: monospace;
  }

  /* 2. USER STATUS WIDGET (HEADER) */
  .user-header-widget {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: 0.5rem;
  }

  .user-info-pill {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
  }

  .user-avatar {
    font-size: 1.1rem;
    line-height: 1;
  }

  .user-meta {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .user-name-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .user-name-row strong {
    font-size: 0.85rem;
    color: #ffffff;
  }

  .role-badge {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    text-transform: uppercase;
    background: rgba(67, 160, 71, 0.2);
    color: #81c784;
  }

  .role-badge.mentor {
    background: rgba(156, 39, 176, 0.25);
    color: #ce93d8;
  }

  .user-stats-row {
    font-size: 0.72rem;
    color: var(--sl-color-gray-3, #9e9e9e);
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .user-xp-display {
    color: #81c784;
    font-weight: 600;
  }

  .meta-separator {
    opacity: 0.5;
  }

  /* Mentor Trigger Button */
  .btn-mentor-trigger {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    background: linear-gradient(135deg, #7b1fa2, #9c27b0);
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(156, 39, 176, 0.35);
  }

  .btn-mentor-trigger:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(156, 39, 176, 0.5);
    background: linear-gradient(135deg, #8e24aa, #ab47bc);
  }

  .mentor-badge-count {
    background: #ffffff;
    color: #7b1fa2;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
  }

  /* Logout Button */
  .btn-logout {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--sl-color-gray-3, #9e9e9e);
    padding: 0.35rem 0.65rem;
    border-radius: 8px;
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-logout:hover {
    background: rgba(244, 67, 54, 0.15);
    border-color: rgba(244, 67, 54, 0.4);
    color: #ff8a80;
  }

  /* 3. PAINEL DE MENTORIA SUSPENSO (MODAL FLOATING) */
  .mentor-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 999998;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(10px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .mentor-modal-window {
    background: var(--sl-color-gray-6, #14171d);
    border: 1px solid rgba(156, 39, 176, 0.4);
    box-shadow: 0 25px 70px rgba(0, 0, 0, 0.6), 0 0 30px rgba(156, 39, 176, 0.2);
    border-radius: 20px;
    width: 100%;
    max-width: 860px;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    animation: modalPop 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    color: #ffffff;
    overflow: hidden;
  }

  .mentor-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 1.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .mentor-title-group {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .mentor-header-icon {
    font-size: 2rem;
    background: rgba(156, 39, 176, 0.2);
    border: 1px solid rgba(156, 39, 176, 0.4);
    padding: 0.5rem;
    border-radius: 14px;
    line-height: 1;
  }

  .mentor-modal-title {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 700;
  }

  .mentor-modal-sub {
    margin: 0.2rem 0 0;
    font-size: 0.85rem;
    color: var(--sl-color-gray-2, #b5b8c2);
  }

  .close-modal-btn {
    background: rgba(255, 255, 255, 0.08);
    border: none;
    color: #ffffff;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-size: 1.1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .close-modal-btn:hover {
    background: rgba(244, 67, 54, 0.3);
    color: #ff8a80;
  }

  /* Metrics Row */
  .mentor-metrics-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    padding: 1.25rem 1.75rem;
    background: rgba(0, 0, 0, 0.2);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .metric-box {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 0.85rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .metric-box.highlight {
    background: rgba(67, 160, 71, 0.12);
    border-color: rgba(67, 160, 71, 0.3);
  }

  .metric-value {
    font-size: 1.4rem;
    font-weight: 800;
    color: #ffffff;
  }

  .metric-box.highlight .metric-value {
    color: #81c784;
  }

  .metric-label {
    font-size: 0.75rem;
    color: var(--sl-color-gray-3, #9e9e9e);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  /* Students Grid */
  .mentor-students-grid {
    padding: 1.5rem 1.75rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  :global(.student-mentor-card) {
    background: rgba(255, 255, 255, 0.04);
